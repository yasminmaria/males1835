---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="theme-color" content="oklch(0.13 0.025 275)" />
	</head>
	<body>
		<div class="scroll-progress" aria-hidden="true"><span data-scroll-progress-fill></span></div>
		<slot />
		<script>
			document.documentElement.classList.add('js-reveal-ready');

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			type Drawable = SVGGeometryElement & { getAttribute(name: string): string | null };

			function drawableShapes(svg: SVGSVGElement): Drawable[] {
				return Array.from(
					svg.querySelectorAll('line, circle, ellipse, rect, polygon, polyline, path')
				) as Drawable[];
			}

			function prepareMotifDraw(svg: SVGSVGElement) {
				drawableShapes(svg).forEach((el, i) => {
					const delay = `${i * 16}ms`;
					if (el.getAttribute('fill') === 'currentColor') {
						el.style.opacity = '0';
						el.style.transition = `opacity 0.5s var(--ease-out-quart) ${delay}`;
					} else {
						const length = el.getTotalLength();
						el.style.strokeDasharray = `${length}`;
						el.style.strokeDashoffset = `${length}`;
						el.style.transition = `stroke-dashoffset 1.1s var(--ease-out-expo) ${delay}`;
					}
				});
			}

			function playMotifDraw(svg: SVGSVGElement) {
				drawableShapes(svg).forEach((el) => {
					if (el.getAttribute('fill') === 'currentColor') {
						el.style.opacity = '1';
					} else {
						el.style.strokeDashoffset = '0';
					}
				});
			}

			const motifs = document.querySelectorAll<SVGSVGElement>('[data-motif-draw]');
			if (!reduceMotion) {
				motifs.forEach(prepareMotifDraw);
			}

			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							if (!reduceMotion) {
								entry.target
									.querySelectorAll<SVGSVGElement>('[data-motif-draw]')
									.forEach(playMotifDraw);
							}
							observer.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
			);

			document.querySelectorAll('.reveal').forEach((el) => {
				if (reduceMotion) {
					el.classList.add('is-visible');
				} else {
					observer.observe(el);
				}
			});

			const progressFill = document.querySelector<HTMLElement>('[data-scroll-progress-fill]');
			if (progressFill) {
				let ticking = false;
				const updateProgress = () => {
					const doc = document.documentElement;
					const scrollable = doc.scrollHeight - doc.clientHeight;
					const progress = scrollable > 0 ? (doc.scrollTop / scrollable) * 100 : 0;
					progressFill.style.width = `${progress}%`;
					ticking = false;
				};
				updateProgress();
				window.addEventListener(
					'scroll',
					() => {
						if (!ticking) {
							requestAnimationFrame(updateProgress);
							ticking = true;
						}
					},
					{ passive: true }
				);
				window.addEventListener('resize', updateProgress);
			}
		</script>
	</body>
</html>
