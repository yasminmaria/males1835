---
import GanhadeiraFigure from '../motifs/GanhadeiraFigure.astro';
---

<section class="hero" aria-label="Abertura">
	<div class="hero-figure reveal" data-figure aria-hidden="true">
		<span class="hero-glow"></span>
		<GanhadeiraFigure />
	</div>

	<div class="hero-copy">
		<p class="hero-kicker reveal">Salvador, janeiro de 1835. Faltam doze dias.</p>
		<h1 class="hero-title reveal">GANHADEIRAS</h1>
		<p class="hero-sub reveal">
			Um jogo sobre a mulher que atravessava a cidade com o sustento na cabeça e a revolta
			embaixo dele.
		</p>

		<div class="hero-ctas reveal">
			<a class="btn btn-primary" href="#premissa">Conheça o projeto</a>
			<a class="btn btn-secondary" href="#convite">Quero apoiar</a>
		</div>

		<p class="hero-micro reveal">Em desenvolvimento para celular. Português, inglês e espanhol.</p>
	</div>

	<a class="hero-scroll reveal" href="#premissa" aria-label="Rolar para conhecer o universo">
		<svg viewBox="0 0 24 40" aria-hidden="true">
			<line x1="12" y1="2" x2="12" y2="30" stroke="currentColor" stroke-width="1.5" />
			<polyline points="4,22 12,32 20,22" fill="none" stroke="currentColor" stroke-width="1.5" />
		</svg>
	</a>
</section>

<style>
	.hero {
		min-height: 100svh;
		display: grid;
		grid-template-columns: minmax(14rem, 22rem) 1fr;
		align-items: center;
		gap: var(--space-2xl);
		padding: var(--space-3xl) var(--space-m) var(--space-xl);
		position: relative;
	}

	.hero-figure {
		position: relative;
		justify-self: center;
	}

	.hero-glow {
		position: absolute;
		top: 4%;
		left: 62%;
		width: 30%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle, var(--highlight) 0%, transparent 70%);
		opacity: 0.35;
		filter: blur(6px);
		pointer-events: none;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-s);
		max-width: 34rem;
	}

	.hero-kicker {
		font-family: var(--font-display);
		font-style: italic;
		font-size: var(--step-1);
		color: var(--ink-muted);
	}

	.hero-title {
		font-size: clamp(2.75rem, 6vw + 1.5rem, 5.5rem);
		letter-spacing: -0.02em;
		overflow-wrap: break-word;
	}

	.hero-sub {
		font-size: var(--step-1);
		color: var(--ink-muted);
		max-width: 38ch;
	}

	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-s);
		margin-top: var(--space-s);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		padding: var(--space-xs) var(--space-l);
		font-family: var(--font-body);
		font-weight: 600;
		font-size: var(--step-0);
		letter-spacing: 0.01em;
		text-decoration: none;
		border: 1.5px solid var(--highlight);
		transition: transform 0.3s var(--ease-out-quart), background 0.3s var(--ease-out-quart), color 0.3s var(--ease-out-quart);
	}

	.btn-primary {
		background: var(--highlight);
		color: var(--bg);
	}

	.btn-primary:hover {
		transform: translateY(-2px);
	}

	.btn-secondary {
		background: transparent;
		color: var(--highlight);
	}

	.btn-secondary:hover {
		background: var(--surface-2);
		transform: translateY(-2px);
	}

	.hero-micro {
		margin-top: var(--space-m);
		font-size: var(--step--1);
		color: var(--ink-muted);
	}

	.hero-scroll {
		position: absolute;
		bottom: var(--space-l);
		left: 50%;
		transform: translateX(-50%);
		color: var(--ink-muted);
	}

	.hero-scroll svg {
		width: 1rem;
		height: 1.7rem;
		animation: hero-scroll-bob 2.2s var(--ease-out-quart) infinite;
	}

	@keyframes hero-scroll-bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(0.35rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-scroll svg {
			animation: none;
		}

		.btn {
			transition: none;
		}
	}

	@media (max-width: 56rem) {
		.hero {
			grid-template-columns: 1fr;
			text-align: center;
			justify-items: center;
			padding-top: var(--space-2xl);
		}

		.hero-figure {
			width: min(52vw, 16rem);
		}

		.hero-copy {
			align-items: center;
		}

		.hero-ctas {
			justify-content: center;
		}
	}
</style>
