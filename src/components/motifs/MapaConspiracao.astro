---
import { regioes, type RegiaoId } from '../../data/regioes';

interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

const positions: Record<RegiaoId, { x: number; y: number }> = {
	'barroquinha': { x: 210, y: 132 },
	'rampa-do-mercado': { x: 128, y: 202 },
	'vitoria': { x: 356, y: 92 },
	'pelourinho': { x: 284, y: 176 },
	'agua-de-meninos': { x: 84, y: 256 },
	'bonfim': { x: 336, y: 222 },
	'porto-e-calcada': { x: 156, y: 276 },
};

const hub = positions['barroquinha'];
const spokes = regioes.filter((r) => r.id !== 'barroquinha').map((r) => positions[r.id]);

const hatch = Array.from({ length: 14 }, (_, i) => {
	const x1 = 20 + i * 32;
	return { x1, y1: 40, x2: x1 - 14, y2: 66 };
});
---

<svg
	class={`motif-mapa ${className}`}
	viewBox="0 0 480 320"
	fill="none"
	role="img"
	aria-labelledby="mapa-title"
	data-motif-draw
>
	<title id="mapa-title">
		Mapa esquemático de Salvador em linguagem de carta náutica, com sete pontos marcados e
		trajetos tracejados convergindo para a Barroquinha
	</title>

	<!-- moldura de papel envelhecido -->
	<polygon
		points="10,18 250,8 470,20 462,150 470,300 220,312 12,296 18,160"
		stroke="var(--line-strong)"
		stroke-width="1.5"
	/>

	<!-- cidade alta: hachura -->
	<g stroke="var(--line)" stroke-width="1.2" opacity="0.7">
		{hatch.map((h) => <line x1={h.x1} y1={h.y1} x2={h.x2} y2={h.y2} />)}
	</g>

	<!-- linha da costa -->
	<path
		d="M14,120 C70,140 120,110 180,132 C240,154 300,118 360,140 C400,154 440,148 466,128"
		stroke="var(--line-strong)"
		stroke-width="2"
	/>

	<!-- trajetos tracejados convergindo para a Barroquinha -->
	<g stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 5" opacity="0.85">
		{spokes.map((p) => <line x1={hub.x} y1={hub.y} x2={p.x} y2={p.y} />)}
	</g>

	<!-- sete pontos -->
	{
		regioes.map((r) => {
			const p = positions[r.id];
			const isHub = r.id === 'barroquinha';
			return (
				<g>
					<circle cx={p.x} cy={p.y} r={isHub ? 6 : 4.5} fill={isHub ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" />
					{isHub && <circle cx={p.x} cy={p.y} r="11" stroke="currentColor" stroke-width="1.5" />}
				</g>
			);
		})
	}

	<!-- objetos esquecidos: papel dobrado, anel de ferro, pano -->
	<g transform="translate(352,244)">
		<g transform="rotate(-8)">
			<rect x="0" y="0" width="46" height="32" stroke="currentColor" stroke-width="1.5" />
			<path d="M0,0 L23,18 L46,0" stroke="currentColor" stroke-width="1.2" />
			<g stroke="currentColor" stroke-width="1" opacity="0.8">
				<path d="M8,22 C11,19 14,22 17,20" />
				<path d="M22,23 C25,20 28,23 31,21" />
			</g>
		</g>
		<circle cx="66" cy="20" r="9" stroke="currentColor" stroke-width="3" fill="none" />
		<path
			d="M-6,40 C4,34 18,34 26,40 C20,46 4,46 -6,40 Z"
			stroke="currentColor"
			stroke-width="1.5"
		/>
	</g>
</svg>

<style>
	.motif-mapa {
		color: var(--highlight);
		width: 100%;
		height: auto;
		overflow: visible;
	}
</style>
