---
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

const cellW = 60;
const cellH = 60;
const gap = 6;
const startX = 8;
const y = 10;
const x = (i: number) => startX + i * (cellW + gap);
const cx = (i: number, span = 1) => x(i) + (cellW * span + gap * (span - 1)) / 2;
const width = startX * 2 + 10 * cellW + 9 * gap;
---

<svg
	class={`motif-board ${className}`}
	viewBox={`0 0 ${width} 96`}
	fill="none"
	role="img"
	aria-labelledby="board-title"
	data-motif-draw
>
	<title id="board-title">
		Vista superior do tabuleiro de dez espaços: acarajé, pomada, uma carta escondida, uma lâmina,
		pólvora e um espaço livre
	</title>

	<!-- acarajé — 2 espaços, mercadoria à mostra -->
	<rect fill="currentColor" x={x(0)} y={y} width={cellW * 2 + gap} height={cellH} />
	<g stroke="var(--bg)" stroke-width="2" stroke-linecap="round" fill="none">
		<path d={`M${cx(0, 2) - 16},${y + 38} C${cx(0, 2) - 16},${y + 24} ${cx(0, 2) - 6},${y + 18} ${cx(0, 2)},${y + 18} C${cx(0, 2) + 6},${y + 18} ${cx(0, 2) + 16},${y + 24} ${cx(0, 2) + 16},${y + 38} Z`} />
		<path d={`M${cx(0, 2) - 12},${y + 24} C${cx(0, 2)},${y + 16} ${cx(0, 2)},${y + 16} ${cx(0, 2) + 12},${y + 24}`} />
	</g>

	<!-- pomada — 1 espaço, cura -->
	<rect stroke="currentColor" stroke-width="2.5" x={x(2)} y={y} width={cellW} height={cellH} />
	<g stroke="currentColor" stroke-width="2" stroke-linecap="square" fill="none">
		<rect x={cx(2) - 10} y={y + 22} width="20" height="24" />
		<rect x={cx(2) - 5} y={y + 15} width="10" height="8" />
	</g>

	<!-- carta — 1 espaço, escondida (contorno tracejado) -->
	<rect
		stroke="currentColor"
		stroke-width="2.5"
		stroke-dasharray="5 4"
		x={x(3)}
		y={y}
		width={cellW}
		height={cellH}
	/>
	<g stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none">
		<rect x={cx(3) - 13} y={y + 20} width="26" height="18" />
		<path d={`M${cx(3) - 13},${y + 20} L${cx(3)},${y + 32} L${cx(3) + 13},${y + 20}`} />
	</g>

	<!-- lâmina — 2 espaços, escondida -->
	<rect
		stroke="currentColor"
		stroke-width="2.5"
		stroke-dasharray="5 4"
		x={x(4)}
		y={y}
		width={cellW * 2 + gap}
		height={cellH}
	/>
	<line
		stroke="currentColor"
		stroke-width="3"
		stroke-linecap="round"
		x1={cx(4, 2) - 26}
		y1={y + 44}
		x2={cx(4, 2) + 26}
		y2={y + 16}
	/>

	<!-- pólvora — 3 espaços, escondida -->
	<rect
		stroke="currentColor"
		stroke-width="2.5"
		stroke-dasharray="5 4"
		x={x(6)}
		y={y}
		width={cellW * 3 + gap * 2}
		height={cellH}
	/>
	<g fill="currentColor">
		{Array.from({ length: 14 }, (_, i) => {
			const gx = x(6) + 14 + (i % 7) * 22 + (Math.floor(i / 7) % 2) * 8;
			const gy = y + 20 + Math.floor(i / 7) * 20;
			return <circle cx={gx} cy={gy} r="2.2" />;
		})}
	</g>

	<!-- livre — 1 espaço -->
	<rect stroke="var(--line-strong)" stroke-width="2" x={x(9)} y={y} width={cellW} height={cellH} />
	<line stroke="var(--line-strong)" stroke-width="2" x1={cx(9) - 8} y1={y + 30} x2={cx(9) + 8} y2={y + 30} />
	<line stroke="var(--line-strong)" stroke-width="2" x1={cx(9)} y1={y + 22} x2={cx(9)} y2={y + 38} />
</svg>

<style>
	.motif-board {
		color: var(--highlight);
		width: 100%;
		height: auto;
		overflow: visible;
	}
</style>
