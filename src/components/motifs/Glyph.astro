---
import type { RegiaoId } from '../../data/regioes';

interface Props {
	name: RegiaoId;
	class?: string;
	label: string;
}

const { name, class: className = '', label } = Astro.props;
---

<svg
	class={`motif-glyph ${className}`}
	viewBox="0 0 48 48"
	fill="none"
	stroke="currentColor"
	stroke-width="3"
	stroke-linecap="square"
	stroke-linejoin="miter"
	role="img"
	aria-label={label}
>
	{
		name === 'agua-de-meninos' && (
			<>
				<path d="M12,24 C12,17 20,13 30,15 C36,16.5 40,20 42,24 C40,28 36,31.5 30,33 C20,35 12,31 12,24 Z" />
				<polygon points="12,24 4,17 4,31" />
				<rect x="29" y="19" width="2" height="2" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === 'bonfim' && (
			<>
				<polygon points="6,24 21,13 21,35" />
				<polygon points="42,24 27,13 27,35" />
				<rect x="20" y="20" width="8" height="8" />
				<line x1="22" y1="28" x2="15" y2="43" />
				<line x1="26" y1="28" x2="33" y2="43" />
			</>
		)
	}
	{
		name === 'rampa-do-mercado' && (
			<>
				<polygon points="10,19 38,19 33,41 15,41" />
				<line x1="14" y1="27" x2="34" y2="27" />
				<line x1="15.5" y1="34" x2="32.5" y2="34" />
				<path d="M18,15 C18,11 21,11 21,7" stroke-linecap="round" />
				<path d="M27,15 C27,11 30,11 30,7" stroke-linecap="round" />
			</>
		)
	}
	{
		name === 'barroquinha' && (
			<>
				<rect x="9" y="7" width="30" height="34" />
				<rect x="9" y="7" width="13.5" height="34" />
				<rect x="25.5" y="7" width="13.5" height="34" />
				<line x1="12" y1="14" x2="20" y2="14" />
				<line x1="12" y1="21" x2="20" y2="21" />
				<line x1="12" y1="28" x2="20" y2="28" />
				<line x1="28" y1="14" x2="36" y2="14" />
				<line x1="28" y1="21" x2="36" y2="21" />
				<line x1="28" y1="28" x2="36" y2="28" />
			</>
		)
	}
	{
		name === 'porto-e-calcada' && (
			<>
				<circle cx="24" cy="9" r="4" />
				<line x1="24" y1="13" x2="24" y2="34" />
				<line x1="16" y1="18" x2="32" y2="18" />
				<path d="M24,34 C24,42 15,43 12,35" stroke-linecap="round" />
				<path d="M24,34 C24,42 33,43 36,35" stroke-linecap="round" />
			</>
		)
	}
	{
		name === 'pelourinho' && (
			<>
				<line x1="8" y1="8" x2="40" y2="8" />
				<line x1="8" y1="40" x2="40" y2="40" />
				<line x1="13" y1="8" x2="13" y2="40" />
				<line x1="19.5" y1="8" x2="19.5" y2="40" />
				<line x1="24" y1="8" x2="24" y2="40" />
				<line x1="28.5" y1="8" x2="28.5" y2="40" />
				<line x1="35" y1="8" x2="35" y2="40" />
			</>
		)
	}
	{
		name === 'vitoria' && (
			<>
				<polygon points="24,6 7,19 41,19" />
				<rect x="10" y="19" width="28" height="22" />
				<rect x="14" y="24" width="6" height="8" />
				<rect x="28" y="24" width="6" height="8" />
				<rect x="21" y="33" width="6" height="8" />
			</>
		)
	}
</svg>

<style>
	.motif-glyph {
		width: 2.25rem;
		height: 2.25rem;
		color: var(--ink-muted);
		flex-shrink: 0;
	}
</style>
